# Copy to server/.env and fill in real values. Never commit server/.env.

# development | testing | production
APP_ENV=development

# PostgreSQL 16. Use your own role/password; see server/README.md#database-setup.
DATABASE_URL=postgresql://futureprint:CHANGE_ME@localhost:5432/futureprint
# Used only by pytest. The database name MUST end with "_test".
TEST_DATABASE_URL=postgresql://futureprint:CHANGE_ME@localhost:5432/futureprint_test

# At least 32 characters in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates existing report share links.
SECRET_KEY=CHANGE_ME_generate_a_long_random_value

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Anonymous session lifetime in hours (sliding: extended on each choice).
SESSION_TTL_HOURS=72

# DEBUG | INFO | WARNING | ERROR, and json | text
LOG_LEVEL=INFO
LOG_FORMAT=text

# Python module path of Person 3's scenario engine, e.g. engine_core.scenario.
# Leave empty to use the in-repo reference stand-in (development only).
SCENARIO_ENGINE_MODULE=
# Unset: the reference stand-in is allowed in development/testing and refused in
# production. Set true/false to override (never true in production).
ALLOW_REFERENCE_ENGINE=

# Optional AI insights (off by default; the product works without it).
AI_INSIGHTS_ENABLED=false
OPENAI_API_KEY=
# Required when AI is enabled. Choose a model your account can use.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20
AI_MAX_QUESTION_CHARS=500
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_REQUESTS_PER_SESSION=20
AI_CACHE_TTL_SECONDS=3600
# Optional, for cost estimates in ai_usage_records (USD per 1M tokens).
AI_INPUT_COST_PER_1M_TOKENS=
AI_OUTPUT_COST_PER_1M_TOKENS=
