# Base URL of the FUTUREPRINT backend (Person 2). Leave empty to use same-origin /api/v1:
# in `npm run dev` Vite proxies /api to the Flask dev server on http://localhost:5000
# (`flask run --port 5000`, see server/README.md). Set an absolute URL for deployed builds.
VITE_API_BASE_URL=

# Optional: where the dev server proxies /api (defaults to http://localhost:5000).
# VITE_DEV_API_PROXY=http://localhost:5000

# true = run the whole journey against in-browser mock data (no backend needed).
VITE_USE_MOCKS=false
